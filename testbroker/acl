# Classic ACL matching examples/cases.example.yaml (subset without TLS cases).
# 'topic deny' takes precedence over read/write rules regardless of line order
# (verified with Mosquitto 2.0.18).

user admin
topic readwrite #

user tasmofleet
topic read stat/#
topic read tele/#
topic write cmnd/#

user homeassistant
topic deny stat/+/FILEDOWNLOAD
topic read stat/#
topic read tele/#

user viewer
topic read tele/#
topic read stat/#

# Tasmota devices: username = Tasmota Topic
pattern read cmnd/%u/#
pattern write stat/%u/#
pattern write tele/%u/#
